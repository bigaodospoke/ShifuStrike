{
  "schemaVersion": 1,
  "id": "shifustrike",
  "version": "${version}",
  "name": "ShifuStrike",
  "description": "Evento de CS no Eclipse Cobblemon: Terroristas contra Antiterroristas em rodadas, com compra de armas do PointBlank, bomba C4, desarme e economia, até um time chegar a 5 vitórias.",
  "authors": ["bigaodospoke"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/shifustrike/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{ "adapter": "kotlin", "value": "com.shifustrike.ShifuStrike" }],
    "client": [{ "adapter": "kotlin", "value": "com.shifustrike.client.ShifuStrikeClient" }],
    "fabric-gametest": [
      "com.shifustrike.gametest.SmokeGameTest",
      "com.shifustrike.gametest.ItemsGameTest",
      "com.shifustrike.gametest.SnapshotGameTest",
      "com.shifustrike.gametest.MatchGameTest",
      "com.shifustrike.gametest.RoundGameTest",
      "com.shifustrike.gametest.DeathGameTest",
      "com.shifustrike.gametest.BombGameTest"
    ]
  },
  "mixins": [
    "shifustrike.mixins.json",
    { "config": "shifustrike.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.0",
    "fabric-language-kotlin": ">=1.13.6+kotlin.2.2.20",
    "cobblemon": ">=1.7.3"
  },
  "recommends": {
    "pointblank": ">=2.2.0"
  }
}
